# --- core ---
DATABASE_URL=postgresql+asyncpg://ais:password@localhost:5432/ais
JWT_SECRET_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_API_KEY=change-me-training-servers
FILE_STORAGE_BASE_PATH=/var/ais/files

# --- admins & notifications ---
ADMIN_EMAILS=admin@example.com          # bootstrap only; manage roles via /admin/users afterwards
ADMIN_NOTIFY_EMAIL=ops@example.com      # new sign-ups / credit requests
EMAIL_BACKEND=console                   # console | smtp
EMAIL_FROM=admin@example.com

# --- sign-up & credit policy ---
SIGNUP_REQUIRE_APPROVAL=true
SIGNUP_AUTO_APPROVE_DOMAINS=            # e.g. chronoboost.io
CREDIT_REQUEST_AUTO_APPROVE_MAX=0       # 0 = every credit request needs an admin
CREDIT_REQUEST_AUTO_APPROVE_WINDOW_DAYS=30
CREDIT_PURCHASE_ENABLED=false           # mock checkout; credits are added with no payment

# --- legal consent ---
CONSENT_REQUIRED=true
TERMS_VERSION=2026-10-01
PRIVACY_VERSION=2026-10-01

# --- data at rest (required) ---
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEYS_PREVIOUS=
ENCRYPT_DATA_AT_REST=true
ALLOW_PLAINTEXT_FILES=true              # set false after `python -m app.tasks.encrypt_files`
